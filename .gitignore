# dependencies
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# OS files
.DS_Store
Thumbs.db
*.pem

# local env files
.env
.env.local
.env*.local
.env.development
.env.production

# Supabase local
supabase/.branches/
supabase/.temp/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Editors (keep shared VS Code settings)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Real vendor photos for the upload script (never commit them)
/photos/

# Real vendor details for the import script (emails, owner notes: never commit them)
/vendor-data/
# Sample reel clips for npm run reels:samples (videos stay out of git)
/reel-samples/

# The Punjabi review sheet (npm run i18n:review); regenerate it any time
/punjabi-review.csv
