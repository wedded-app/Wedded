    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "blurhash": "^2.0.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "backend": "bash scripts/backend.sh",
    "photos:upload": "tsx scripts/upload-vendor-photos.ts",
    "photos:samples": "tsx scripts/upload-vendor-photos.ts --samples --local",
    "photos:to-aws": "tsx scripts/copy-photos-to-aws.ts",
    "storage:copy": "tsx scripts/copy-storage.ts",
    "reels:samples": "tsx scripts/reel-samples.ts",
    "stories:samples": "tsx scripts/story-samples.ts",
    "requests:samples": "tsx scripts/request-samples.ts",
    "vendors:import": "tsx scripts/import-vendors.ts",
    "vendors:invite": "tsx scripts/invite-vendor.ts",
    "demo:check": "tsx scripts/demo-check.ts",
    "demo:samples": "tsx scripts/demo-samples.ts",
    "report": "tsx scripts/founders-report.ts",
    "db:types": "supabase gen types typescript --local > src/types/database.ts && prettier --write src/types/database.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "availability": "tsx scripts/set-availability.ts"
  },
  "private": true,
  "license": "UNLICENSED",
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@react-native-community/netinfo$": "<rootDir>/node_modules/@react-native-community/netinfo/jest/netinfo-mock.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/",
      "/infra/"
    ]
  }
}
