# Copy this file to .env.local (gitignored) and fill in the values.
# Local development: run `supabase start`, then `supabase status` shows both values.
# On a real phone, use your Mac's Wi-Fi IP instead of 127.0.0.1
# (e.g. http://10.0.0.5:54321), since the phone can't reach your Mac's localhost.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The website that shows vendor pages to people without the app, e.g.
# https://example.com. The QR table tent links here. Leave empty until there's
# a domain; the app then uses a placeholder and warns before printing.
EXPO_PUBLIC_SITE_URL=

# Where vendor photos load from. Empty: Supabase Storage. Set it to the AWS
# CloudFront address (MediaUrl from `cd infra && npx cdk deploy`) once the photos
# have gone through AWS (npm run photos:samples -- --aws, or photos:upload with --aws).
EXPO_PUBLIC_MEDIA_URL=

# The Wedded team's WhatsApp number, for "Ask the Wedded team" on a vendor's
# page checklist (My business). Digits with the country code, e.g. 15305550100.
# Not a secret. Unset, the checklist says to tell the team instead.
EXPO_PUBLIC_TEAM_WHATSAPP=

# Where crash and error reports go: the DSN of the Sentry project (Settings >
# Projects > Client Keys). Not a secret; it only lets the app send reports in.
# Empty: no reports. The dev server never sends any either.
EXPO_PUBLIC_SENTRY_DSN=
